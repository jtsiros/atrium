#!/usr/bin/env python3
"""Regenerate daemon/src/ha/icons.rs from a Nerd Font.

Home Assistant names icons `mdi:some-name`. Nerd Fonts carry the whole
Material Design Icons set as glyphs named `md-some_name`, so the mapping is
mechanical — but it has to be extracted from a font rather than guessed, and
the result is large enough that it belongs in a generated file.

Usage:
    scripts/generate-icon-map [path/to/SymbolsNerdFontMono.ttf]
"""

import re
import subprocess
import sys
from pathlib import Path

try:
    from fontTools.ttLib import TTFont
except ImportError:
    sys.exit("fontTools is required: pip install fonttools")

OUT = Path(__file__).resolve().parent.parent / "daemon" / "src" / "ha" / "icons.rs"


def find_font() -> str:
    listing = subprocess.run(
        ["fc-list"], capture_output=True, text=True, check=True
    ).stdout
    for line in listing.splitlines():
        if "Symbols Nerd Font Mono" in line:
            return line.split(":", 1)[0]
    sys.exit("could not find Symbols Nerd Font Mono; pass the path explicitly")


def main() -> None:
    path = sys.argv[1] if len(sys.argv) > 1 else find_font()
    font = TTFont(path, fontNumber=0)

    icons: dict[str, int] = {}
    skipped = 0
    for codepoint, glyph in font.getBestCmap().items():
        if not glyph.startswith("md-"):
            continue
        # Home Assistant spells these with dashes; the font uses underscores.
        name = glyph[3:].replace("_", "-")
        # These names come out of a font file and are written into Rust source.
        # Anything outside this alphabet could close the string literal.
        if not re.fullmatch(r"[a-z0-9-]+", name):
            skipped += 1
            continue
        # Lowest codepoint wins, so regenerating is deterministic.
        if name not in icons or codepoint < icons[name]:
            icons[name] = codepoint

    rows = "\n".join(
        f'    ("{name}", \'\\u{{{codepoint:X}}}\'),'
        for name, codepoint in sorted(icons.items())
    )
    OUT.write_text(
        f'''// Generated by scripts/generate-icon-map from Symbols Nerd Font Mono.
// Home Assistant names icons `mdi:some-name`; Nerd Fonts carry the Material
// Design set as `md-some_name`. Do not edit by hand.

static ICONS: &[(&str, char)] = &[
{rows}
];

pub fn glyph(name: &str) -> Option<char> {{
    let name = name.strip_prefix("mdi:").unwrap_or(name);
    if name.is_empty() {{
        return None;
    }}
    ICONS
        .binary_search_by(|(candidate, _)| (*candidate).cmp(name))
        .ok()
        .map(|index| ICONS[index].1)
}}

pub fn count() -> usize {{
    ICONS.len()
}}

#[cfg(test)]
mod tests {{
    use super::*;

    #[test]
    fn the_table_is_sorted_so_binary_search_is_valid() {{
        assert!(ICONS.windows(2).all(|w| w[0].0 < w[1].0), "ICONS must be sorted and unique");
    }}

    #[test]
    fn the_generated_table_is_not_empty() {{
        assert!(count() > 6000, "expected the full Material Design set, got {{}}", count());
    }}

    #[test]
    fn names_resolve_with_or_without_the_prefix() {{
        assert_eq!(glyph("mdi:sofa"), glyph("sofa"));
        assert!(glyph("mdi:sofa").is_some());
    }}

    #[test]
    fn every_icon_this_project_falls_back_to_exists() {{
        for name in [
            "texture-box", "help-circle-outline", "lightbulb", "lightbulb-outline",
            "toggle-switch-outline", "fan", "lock", "window-shutter", "thermostat",
            "speaker", "palette", "script-text", "gesture-tap-button",
            "checkbox-marked-circle", "checkbox-blank-circle-outline", "eye",
            "air-humidifier", "remote", "home", "stairs",
        ] {{
            assert!(glyph(name).is_some(), "fallback icon {{name}} is missing");
        }}
    }}

    #[test]
    fn an_unknown_name_is_none_not_a_blank_glyph() {{
        assert_eq!(glyph("mdi:definitely-not-an-icon"), None);
        assert_eq!(glyph(""), None);
        assert_eq!(glyph("mdi:"), None);
    }}
}}
''',
        encoding="utf-8",
    )
    print(f"wrote {OUT} with {len(icons)} icons")
    if skipped:
        print(f"skipped {skipped} glyph names that were not [a-z0-9-]")


if __name__ == "__main__":
    main()
